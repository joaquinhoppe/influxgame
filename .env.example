# --- Admin (panel /admin y teclas S/N/R del proyector) ---
ADMIN_KEY=profe

# --- InfluxDB (si cambias usuario/clave/token con datos existentes: docker compose down -v) ---
INFLUX_USER=admin
INFLUX_PASSWORD=adminadmin123
INFLUX_TOKEN=tug-of-war-token
INFLUX_ORG=aula
INFLUX_BUCKET=tirayafloja

# --- Puertos del host (localhost:PORT) ---
PORT=3000
INFLUX_PORT=8086

# --- Juego ---
SEED_POINTS=2000000
# La soga se adapta: ventaja para ganar = jugadores x WIN_PER_PLAYER (entre WIN_MIN y WIN_MAX)
WIN_PER_PLAYER=4
WIN_MIN=30
WIN_MAX=400
